<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monthly Wi-Fi Subscribers - BelPan House Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800 font-sans pb-10 max-w-md mx-auto min-h-screen flex flex-col relative">
  <header class="bg-cyan-700 text-white p-4 shadow-md rounded-b-2xl mb-3 flex justify-between items-center sticky top-0 z-50">
    <h1 class="text-lg font-bold">📅 Monthly Wi-Fi Subscribers</h1>
    <button onclick="location.href='index.html'" class="bg-cyan-900 hover:bg-cyan-950 text-white px-3 py-1.5 rounded-xl text-xs font-semibold">⬅️ Menu</button>
  </header>

  <main class="px-4 flex-1 space-y-4">
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-200">
      <h2 class="font-bold text-gray-700 mb-3 text-sm uppercase">Add Monthly Subscriber</h2>
      <form id="monthlyForm" class="space-y-3">
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="text-xs font-semibold text-gray-500">Category Table</label>
            <select id="mthTable" class="w-full p-2.5 border rounded-xl text-sm outline-none font-semibold text-cyan-800">
              <option value="Students">🎓 Students</option>
              <option value="Adults">👔 Adults</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-semibold text-gray-500">Full Name</label>
            <input type="text" id="mthName" required placeholder="e.g. Juan Dela Cruz" class="w-full p-2.5 border rounded-xl text-sm outline-none">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="text-xs font-semibold text-gray-500">Last Paid Month</label>
            <input type="text" id="mthMonth" required placeholder="e.g. November 2026" class="w-full p-2.5 border rounded-xl text-sm outline-none">
          </div>
          <div>
            <label class="text-xs font-semibold text-gray-500">Amount Paid (₱)</label>
            <input type="number" step="1" id="mthAmount" required placeholder="300" class="w-full p-2.5 border rounded-xl text-sm outline-none font-bold">
          </div>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-500">Status</label>
          <select id="mthStatus" class="w-full p-2.5 border rounded-xl text-sm outline-none font-semibold">
            <option value="Paid">✅ Paid (Updated)</option>
            <option value="Unpaid / Due">🔴 Unpaid / Due</option>
          </select>
        </div>
        <button type="submit" class="w-full bg-cyan-600 text-white font-bold py-3 rounded-xl hover:bg-cyan-700 transition">Save Subscriber</button>
      </form>
    </div>

    <!-- STUDENTS TABLE -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-200 space-y-3">
      <h3 class="font-bold text-cyan-800 text-sm uppercase border-b pb-1">🎓 Students List</h3>
      <div id="studentsList" class="space-y-2 text-sm">
        <p class="text-gray-400 text-center text-xs">Loading students...</p>
      </div>
    </div>

    <!-- ADULTS TABLE -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-200 space-y-3">
      <h3 class="font-bold text-cyan-800 text-sm uppercase border-b pb-1">👔 Adults List</h3>
      <div id="adultsList" class="space-y-2 text-sm">
        <p class="text-gray-400 text-center text-xs">Loading adults...</p>
      </div>
    </div>
  </main>

  <script>
    const API_URL = "https://script.google.com/macros/s/AKfycbwxJzrBW2rV2xQuxMQf-xdhlqP4xRVn1O4aZktGkuA8rEICsFQemGne2_0ecc3gh-V7/exec";
    const currentUser = localStorage.getItem("household_hub_user") || "";

    async function fetchMonthlyData() {
      try {
        const res = await fetch(`${API_URL}?user=${encodeURIComponent(currentUser)}`);
        const json = await res.json();
        if (json.status === "success") {
          renderList('studentsList', json.data.hotspotStudents || []);
          renderList('adultsList', json.data.hotspotAdults || []);
        }
      } catch (e) { console.error(e); }
    }

    function renderList(containerId, data) {
      const container = document.getElementById(containerId);
      if (!data.length) { container.innerHTML = '<p class="text-gray-400 text-center text-xs">No records found.</p>'; return; }
      container.innerHTML = data.map(m => `
        <div class="p-2.5 bg-cyan-50/50 rounded-xl border border-cyan-100 flex justify-between items-center text-xs">
          <div>
            <div class="font-bold text-gray-800">${m.name}</div>
            <div class="text-gray-500">Last Paid: <span class="font-semibold text-cyan-900">${m.lastpaidmonth || 'N/A'}</span></div>
          </div>
          <div class="text-right">
            <div class="font-bold text-cyan-900">₱${parseFloat(m.amountpaid || 0).toFixed(2)}</div>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${m.status === 'Paid' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">${m.status}</span>
          </div>
        </div>
      `).join('');
    }

    document.getElementById('monthlyForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      await fetch(API_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "addMonthlyHotspotMember",
          targetTable: document.getElementById('mthTable').value,
          name: document.getElementById('mthName').value,
          lastPaidMonth: document.getElementById('mthMonth').value,
          amountPaid: document.getElementById('mthAmount').value,
          status: document.getElementById('mthStatus').value,
          actor: currentUser
        })
      });
      alert("Subscriber saved successfully!");
      document.getElementById('monthlyForm').reset();
      setTimeout(fetchMonthlyData, 1500);
    });

    fetchMonthlyData();
  </script>
</body>
</html>
